<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net462;net8.0;net10.0</TargetFrameworks>
    <NeutralLanguage>en</NeutralLanguage>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>icon.png</PackageIcon>
    <Description>PlainTextReport is a .NET library to generate a plain text report from a collection of objects.</Description>
    <PackageProjectUrl>https://github.com/fmazzant/PlainTextReport</PackageProjectUrl>
    <RepositoryUrl>https://github.com/fmazzant/PlainTextReport</RepositoryUrl>
    <PackageTags>PlainTextReport;report;plain-text;text-table;c-sharp</PackageTags>
    <PackageId>Mafesoft.PlainTextReport</PackageId>
    <Authors>Federico Mazzanti</Authors>
    <Copyright>Copyright (c) 2024 Federico Mazzanti</Copyright>
    <AssemblyName>Mafesoft.PlainTextReport</AssemblyName>
    <RootNamespace>Mafesoft.PlainTextReport</RootNamespace>
    <Title>Mafesoft.PlainTextReport</Title>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <Product>PlainTextReport</Product>
  </PropertyGroup>

  <!-- XML documentation, so the comments are shown by IntelliSense -->
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Symbols package (.snupkg) and Source Link, to step into the library while debugging -->
  <PropertyGroup>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PlainTextReport.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\assets\icon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
